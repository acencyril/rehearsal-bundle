{#-
    The Rehearsal section. It extends rehearsal.parent_template (your admin layout), which
    must define "title" and "body". To change the markup, override this file in
    templates/bundles/RehearsalBundle/index.html.twig, or only its "rehearsal_content"
    or "rehearsal_styles" block.
-#}
{% extends parent_template %}
{% trans_default_domain 'rehearsal' %}
{% block title %}{{ 'page.title'|trans }}{% endblock %}
{% block body %}
{% set set = board.set %}
<div class="rh" id="rehearsal">
    {% block rehearsal_styles %}
    <style>
        /* Every colour is a --rehearsal-* custom property (README, "The section's look"). The defaults
           derive from the page's own text colour (currentColor): lines, cards, muted text and the
           state colours are mixes of it, so the section reads on a light and on a dark admin alike,
           in the admin's font, whatever the visitor's system theme. */
        .rh { --rh-ink: var(--rehearsal-ink, currentColor); --rh-muted: var(--rehearsal-muted, color-mix(in srgb, currentColor 64%, transparent));
            --rh-line: var(--rehearsal-line, color-mix(in srgb, currentColor 13%, transparent)); --rh-card: var(--rehearsal-card, color-mix(in srgb, currentColor 3%, transparent));
            --rh-accent-tone: var(--rehearsal-accent, #3a5bd9); --rh-ok-tone: var(--rehearsal-ok, #16a34a); --rh-ko-tone: var(--rehearsal-ko, #dc2626); --rh-wait-tone: var(--rehearsal-wait, #d97706);
            --rh-accent: color-mix(in srgb, var(--rh-accent-tone) 80%, var(--rh-ink));
            --rh-ok: color-mix(in srgb, var(--rh-ok-tone) 72%, var(--rh-ink)); --rh-ok-bg: color-mix(in srgb, var(--rh-ok-tone) 13%, transparent);
            --rh-ko: color-mix(in srgb, var(--rh-ko-tone) 72%, var(--rh-ink)); --rh-ko-bg: color-mix(in srgb, var(--rh-ko-tone) 13%, transparent);
            --rh-wait: color-mix(in srgb, var(--rh-wait-tone) 72%, var(--rh-ink)); --rh-wait-bg: color-mix(in srgb, var(--rh-wait-tone) 13%, transparent);
            --rh-ok-solid: var(--rehearsal-ok-solid, #15803d);
            box-sizing: border-box; min-width: 0; max-width: var(--rehearsal-max-width, 60rem); margin: 0 auto; padding: var(--rehearsal-padding, 0); color: var(--rh-ink); font-family: var(--rehearsal-font, inherit); }
        /* An admin that says it is dark gets brighter default tones. */
        :root[data-theme="dark"] .rh { --rh-accent-tone: var(--rehearsal-accent, #8ea6ff); --rh-ok-tone: var(--rehearsal-ok, #5fd39a); --rh-ko-tone: var(--rehearsal-ko, #ff8a80); --rh-wait-tone: var(--rehearsal-wait, #f3c466); }
        .rh h1 { font-size: 1.6rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
        .rh h2 { font-size: 1.1rem; margin: 2rem 0 .75rem; }
        .rh-lead, .rh-muted { color: var(--rh-muted); }
        .rh-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem 1.5rem; align-items: flex-start; }
        .rh-meta { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; font-size: .85rem; }
        .rh-pill { display: inline-flex; align-items: center; gap: .3rem; padding: .1rem .6rem; border-radius: 999px; font-size: .78rem; font-weight: 600; background: var(--rh-line); color: var(--rh-ink); white-space: nowrap; }
        .rh-pill.is-validated, .rh-pill.is-passed { background: var(--rh-ok-bg); color: var(--rh-ok); }
        .rh-pill.is-rejected, .rh-pill.is-failed { background: var(--rh-ko-bg); color: var(--rh-ko); }
        .rh-pill.is-pending, .rh-pill.is-not_run { background: var(--rh-wait-bg); color: var(--rh-wait); }
        .rh-flash { margin: 1rem 0; padding: .7rem 1rem; border-radius: .6rem; background: var(--rh-card); border: 1px solid var(--rh-line); font-weight: 600; }
        .rh-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .75rem; margin: 1.5rem 0; }
        .rh-kpi { background: var(--rh-card); border: 1px solid var(--rh-line); border-radius: .75rem; padding: .8rem 1rem; }
        .rh-kpi b { display: block; font-size: 1.5rem; line-height: 1.2; }
        .rh-kpi span { color: var(--rh-muted); font-size: .85rem; }
        .rh-card, .rh-change { background: var(--rh-card); border: 1px solid var(--rh-line); border-radius: .9rem; padding: 1.1rem 1.25rem; margin: 0 0 1rem; }
        .rh-change { border-left: 4px solid var(--rh-wait); scroll-margin-top: 5rem; }
        .rh-change.is-validated { border-left-color: var(--rh-ok); }
        .rh-change.is-rejected { border-left-color: var(--rh-ko); }
        .rh-change-head { display: flex; flex-wrap: wrap; gap: .5rem 1rem; justify-content: space-between; align-items: baseline; }
        .rh-change h3 { margin: 0; font-size: 1.05rem; }
        .rh-label { display: block; margin-top: .9rem; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--rh-muted); }
        .rh p { margin: .35rem 0; }
        .rh a { color: var(--rh-accent); }
        .rh-fail { margin: .4rem 0 0; padding-left: 1.2rem; color: var(--rh-ko); font-size: .9rem; }
        .rh pre { overflow: auto; max-width: 100%; max-height: 20rem; padding: .75rem; border-radius: .5rem; background: var(--rh-line); font-size: .8rem; }
        .rh-decision { margin-top: .9rem; padding: .6rem .8rem; border-radius: .6rem; background: var(--rh-ok-bg); }
        .rh-decision.is-rejected { background: var(--rh-ko-bg); }
        .rh-decision.is-earlier { background: var(--rh-line); }
        .rh-form { display: grid; gap: .5rem; margin-top: 1rem; max-width: 40rem; }
        .rh-form textarea { box-sizing: border-box; width: 100%; min-height: 4.5rem; padding: .6rem .7rem; font: inherit; color: inherit; background: transparent; border: 1px solid var(--rh-line); border-radius: .5rem; }
        .rh-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
        .rh-btn { font: inherit; font-weight: 650; padding: .5rem 1.1rem; border-radius: .5rem; border: 1px solid transparent; cursor: pointer; }
        .rh-btn.is-validate { background: var(--rh-ok-solid); color: #fff; }
        .rh-btn.is-reject { background: transparent; color: var(--rh-ko); border-color: var(--rh-ko); }
        .rh-btn:focus-visible, .rh-form textarea:focus-visible { outline: 3px solid var(--rh-accent); outline-offset: 2px; }
        .rh-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        /* The summary card. Each --rh-sum-* token falls back to the page's --rh-* ones: set
           either on your admin (light, dark, your brand) and the card follows. */
        .rh-sum { --_bg: var(--rh-sum-bg, color-mix(in srgb, var(--rh-accent) 5%, transparent)); --_tile: var(--rh-sum-tile, var(--rh-card)); --_line: var(--rh-sum-line, var(--rh-line));
            --_ink: var(--rh-sum-ink, var(--rh-ink)); --_muted: var(--rh-sum-muted, var(--rh-muted)); --_accent: var(--rh-sum-accent, var(--rh-accent));
            --_ok: var(--rh-sum-ok, var(--rh-ok)); --_ko: var(--rh-sum-ko, var(--rh-ko)); --_wait: var(--rh-sum-wait, var(--rh-wait));
            margin: .9rem 0 .4rem; padding: 1rem 1.1rem 1.1rem; border: 1px solid var(--_line); border-radius: .8rem; background: var(--_bg); color: var(--_ink); }
        .rh .rh-sum-title { margin: 0 0 .6rem; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--_muted); }
        .rh-sum-hero { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1.5rem; margin-bottom: .9rem; }
        .rh .rh-sum-move { display: flex; align-items: baseline; gap: .7rem; margin: 0; font-variant-numeric: tabular-nums; letter-spacing: -.03em; line-height: 1.05; }
        .rh-sum-from { font-size: clamp(1.6rem, 4vw, 2.3rem); font-weight: 650; color: var(--_muted); }
        .rh-sum-arrow { font-size: clamp(1.3rem, 3vw, 1.8rem); color: var(--_accent); }
        .rh-sum-to { font-size: clamp(2rem, 5.5vw, 3rem); font-weight: 750; }
        .rh-sum-facts { flex: 1 1 16rem; min-width: 0; }
        .rh .rh-sum-facts p { margin: .1rem 0; color: var(--_muted); }
        .rh .rh-sum-facts .rh-sum-ahead { color: var(--_ink); font-weight: 600; }
        .rh-sum-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: .6rem; }
        .rh-sum-tile { min-width: 0; padding: .7rem .85rem; border: 1px solid var(--_line); border-radius: .6rem; background: var(--_tile); }
        .rh .rh-sum-tile h5 { margin: 0 0 .3rem; font-size: .7rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--_muted); }
        .rh .rh-sum-tile p { margin: .15rem 0; }
        .rh-sum-tile code { font-size: .85em; overflow-wrap: anywhere; }
        .rh-sum-list { margin: .1rem 0 0; padding: 0; list-style: none; }
        .rh-sum-list li { margin: .3rem 0; overflow-wrap: break-word; }
        .rh-sum-list li + li { padding-top: .3rem; border-top: 1px dashed var(--_line); }
        .rh-sum-name { display: block; }
        .rh-sum-muted { color: var(--_muted); }
        .rh-sum-st { font-weight: 600; white-space: nowrap; }
        .rh-sum-st.is-passed, .rh-sum-st.is-applied, .rh-sum-st.is-untested, .rh-sum-st.is-validated { color: var(--_ok); }
        .rh-sum-st.is-failed, .rh-sum-st.is-reverted, .rh-sum-st.is-rector_failed, .rh-sum-st.is-rejected { color: var(--_ko); }
        .rh-sum-st.is-pending, .rh-sum-st.is-not_run, .rh-sum-st.is-proposed, .rh-sum-st.is-unchanged { color: var(--_wait); }
        .rh-sum-refused { color: var(--_ko); }
        .rh-history { list-style: none; padding: 0; margin: 0; }
        .rh-history li { padding: .5rem 0; border-bottom: 1px solid var(--rh-line); }
    </style>
    {% endblock %}

    {% block rehearsal_content %}
    <div class="rh-head">
        <div>
            <h1>{{ 'page.title'|trans }}</h1>
            <p class="rh-lead">{{ 'page.lead'|trans }}</p>
        </div>
        <div class="rh-meta">
            <span class="rh-pill" title="{{ ('validation.' ~ board.validation ~ '_help')|trans }}">{{ ('validation.' ~ board.validation)|trans }}</span>
            {% if set.revision %}<span class="rh-muted">{{ 'page.revision'|trans({'%revision%': set.revision}) }}</span>{% endif %}
            {% if set.link %}<a href="{{ set.link }}" rel="noopener noreferrer" target="_blank">{{ 'page.link'|trans }}</a>{% endif %}
        </div>
    </div>

    {% for key in flashes %}<p class="rh-flash" role="status">{{ key|trans }}</p>{% endfor %}

    {% if set.title %}<h2>{{ set.title }}</h2>{% endif %}
    {% if set.summary %}<p>{{ set.summary|nl2br }}</p>{% endif %}

    {% if board.items %}
        <div class="rh-kpis">
            <div class="rh-kpi"><b>{{ board.counts.pending }}</b><span>{{ 'count.pending'|trans }}</span></div>
            <div class="rh-kpi"><b>{{ board.counts.validated }}</b><span>{{ 'count.validated'|trans }}</span></div>
            <div class="rh-kpi"><b>{{ board.counts.rejected }}</b><span>{{ 'count.rejected'|trans }}</span></div>
        </div>
    {% endif %}

    {% for item in board.items %}
        {% set c = item.change %}
        <article class="rh-change is-{{ item.state }}" id="change-{{ c.id }}">
            <div class="rh-change-head">
                <h3>{{ c.title }}</h3>
                <div class="rh-meta">
                    {% if c.source %}<span class="rh-muted">{{ 'change.source'|trans({'%source%': c.source}) }}</span>{% endif %}
                    <span class="rh-pill is-{{ item.state }}">{{ ('state.' ~ item.state)|trans }}</span>
                </div>
            </div>

            {% if c.summary %}{% include '@Rehearsal/_summary.html.twig' with {s: c.summary, state: item.state, id: c.id} only %}{% endif %}

            {% if c.detail %}<span class="rh-label">{{ 'change.notes'|trans }}</span><p>{{ c.detail|nl2br }}</p>{% endif %}
            {% if c.replaced %}<span class="rh-label">{{ 'change.replaced'|trans }}</span><p>{{ c.replaced|nl2br }}</p>{% endif %}
            {% if c.check %}<span class="rh-label">{{ 'change.check'|trans }}</span><p>{{ c.check|nl2br }}</p>{% endif %}
            {% if c.url %}<p><a href="{{ c.url }}" target="_blank" rel="noopener">{{ 'change.open'|trans }}</a></p>{% endif %}

            <span class="rh-label">{{ 'tests.title'|trans }}</span>
            {% if c.tests %}
                <p><span class="rh-pill is-{{ c.tests.status }}">{{ ('tests.' ~ c.tests.status)|trans }}</span>{% if c.tests.summary %} <span class="rh-muted">{{ c.tests.summary }}</span>{% endif %}{% if c.tests.at %} <span class="rh-muted">· {{ c.tests.at }}</span>{% endif %}</p>
                {% if c.tests.failures %}<ul class="rh-fail">{% for f in c.tests.failures %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
                {% if c.tests.output %}<details><summary class="rh-muted">{{ 'tests.output'|trans }}</summary><pre>{{ c.tests.output }}</pre></details>{% endif %}
            {% else %}
                <p class="rh-muted">{{ 'tests.none'|trans }}</p>
            {% endif %}

            {% if item.decision %}
                <div class="rh-decision is-{{ item.decision.decision }}">
                    <strong>{{ ('state.' ~ item.decision.decision)|trans }}</strong>
                    <span class="rh-muted">{{ (item.decision.auto ? 'decision.auto' : 'decision.by')|trans({'%who%': item.decision.by ?: '—', '%date%': item.decision.at|date('Y-m-d H:i')}) }}</span>
                    {% if item.decision.comment %}<p>{{ item.decision.comment|nl2br }}</p>{% endif %}
                </div>
            {% elseif item.earlier %}
                <div class="rh-decision is-earlier">
                    <span class="rh-muted">{{ 'decision.earlier'|trans({'%decision%': ('state.' ~ item.earlier.decision)|trans, '%revision%': item.earlier.revision ?: '—'}) }}</span>
                    {% if item.earlier.comment %}<p>{{ item.earlier.comment|nl2br }}</p>{% endif %}
                </div>
            {% endif %}

            {% set form %}
                <form class="rh-form" method="post" action="{{ path('rehearsal_decide', route_params|merge({id: c.id})) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('rehearsal-' ~ c.id) }}">
                    <label class="rh-label" for="comment-{{ c.id }}">{{ 'form.comment'|trans }}</label>
                    <textarea id="comment-{{ c.id }}" name="comment" maxlength="4000" placeholder="{{ 'form.placeholder'|trans }}"></textarea>
                    <div class="rh-actions">
                        <button class="rh-btn is-validate" type="submit" name="decision" value="validate">{{ 'form.validate'|trans }}</button>
                        <button class="rh-btn is-reject" type="submit" name="decision" value="reject">{{ 'form.reject'|trans }}</button>
                    </div>
                    <p class="rh-muted">{{ 'form.reject_hint'|trans }}</p>
                </form>
            {% endset %}
            {% if item.decision %}
                <details><summary class="rh-muted">{{ 'decision.change'|trans }}</summary>{{ form }}</details>
            {% else %}
                {{ form }}
            {% endif %}
        </article>
    {% else %}
        <div class="rh-card"><p class="rh-muted">{{ 'page.empty'|trans }}</p></div>
    {% endfor %}

    {% if board.history %}
        <h2>{{ 'history.title'|trans }}</h2>
        <ul class="rh-history">
            {% for d in board.history %}
                <li><span class="rh-pill is-{{ d.decision }}">{{ ('state.' ~ d.decision)|trans }}</span>
                    <span class="rh-muted">{{ d.at|date('Y-m-d H:i') }} · {{ d.change }}{% if d.revision %}@{{ d.revision }}{% endif %} · {{ d.auto ? 'history.auto'|trans : (d.by ?: '—') }}</span>
                    {% if d.comment %}<br>{{ d.comment }}{% endif %}</li>
            {% endfor %}
        </ul>
    {% endif %}
    {% endblock %}
</div>
{% endblock %}
