{% trans_default_domain 'rehearsal' %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:24px;font:15px/1.55 system-ui,-apple-system,'Segoe UI',sans-serif;color:#18181b;background:#f6f6f7">
<div style="max-width:560px;margin:0 auto;background:#fff;border:1px solid #e4e4e8;border-radius:12px;padding:24px">
    <h1 style="font-size:20px;margin:0 0 8px">{{ 'mail.proposed.title'|trans({'%count%': changes|length}, 'rehearsal', locale) }}</h1>
    {% if set.title %}<p style="margin:0 0 16px;color:#6b6b76">{{ set.title }}</p>{% endif %}
    <ul style="padding-left:18px">
        {% for c in changes %}
            <li style="margin:0 0 10px"><strong>{{ c.title }}</strong>
                — {{ ('tests.' ~ (c.tests ? c.tests.status : 'not_run'))|trans({}, 'rehearsal', locale) }}
                {% if c.id in auto %} — {{ 'mail.proposed.auto'|trans({}, 'rehearsal', locale) }}{% endif %}
                {% if c.check %}<br><span style="color:#6b6b76">{{ c.check }}</span>{% endif %}</li>
        {% endfor %}
    </ul>
    {% if admin_url %}<p><a href="{{ admin_url }}" style="display:inline-block;padding:10px 18px;border-radius:8px;background:#18181b;color:#fff;text-decoration:none;font-weight:600">{{ 'mail.cta'|trans({}, 'rehearsal', locale) }}</a></p>{% endif %}
    <p style="color:#6b6b76;font-size:13px;margin-top:24px">{{ 'mail.footer'|trans({}, 'rehearsal', locale) }}</p>
</div>
</body>
</html>
